{
  "uid": "k6-performance",
  "title": "Sapixi k6 Performance",
  "tags": ["k6", "sapixi", "performance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Run k6",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(k6_vus, testid)", "refId": "VariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(k6_vus{testid=~\"$testid\"}, project_id)", "refId": "VariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": {"query": "label_values(k6_vus{testid=~\"$testid\"}, deployment_id)", "refId": "VariableQueryEditor-VariableQuery"},
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "HTTP requests",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(k6_http_reqs_total{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"})",
          "instant": true
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(k6_http_req_duration_p95{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"})",
          "instant": true
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(k6_http_req_duration_p99{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"})",
          "instant": true
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(k6_http_req_failed_rate{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"}) * 100",
          "instant": true
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests / second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"}[$__rate_interval]))",
          "legendFormat": "RPS"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Virtual users",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(k6_vus{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"})",
          "legendFormat": "VUs"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p95 / p99",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 14},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(k6_http_req_duration_p95{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"})",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "avg(k6_http_req_duration_p99{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"})",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Error rate",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 14},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(k6_http_req_failed_rate{testid=~\"$testid\",project_id=~\"$project\",deployment_id=~\"$deployment\"}) * 100",
          "legendFormat": "Errors %"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}}
    }
  ]
}
