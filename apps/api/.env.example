APP_ENV=development

SECRET_KEY=replace-with-a-long-random-secret

DATABASE_URL=postgresql://piximind_app:replace-password@127.0.0.1:5432/piximind_platform

AUTH_SESSION_HOURS=8
AUTH_REMEMBER_DAYS=7

CREDENTIAL_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

INTEGRATION_TIMEOUT_SECONDS=10
INTEGRATION_WORKER_SLEEP_SECONDS=60

# Temps maximal accordé à Ollama, LiteLLM, vLLM
# ou à une API compatible OpenAI.
AI_REQUEST_TIMEOUT_SECONDS=180
AI_OLLAMA_NUM_PREDICT=4096
AI_OLLAMA_KEEP_ALIVE=30m
AI_OLLAMA_NUM_CTX=16384
AI_MAX_SOURCE_CONTEXT_BYTES=40000

# Laisser vide pour reprendre le modèle utilisé par la génération.
# Renseigner une valeur uniquement pour utiliser un modèle
# de diagnostic global lorsqu'aucun modèle de génération n'existe.
DEPLOYMENT_AI_TIMEOUT_SECONDS=180
DEPLOYMENT_AI_MODEL=

PROJECT_ARCHIVE_ROOT=var/project-archives
PROJECT_ARCHIVE_MAX_BYTES=104857600
PROJECT_ARCHIVE_MAX_ENTRIES=20000
PROJECT_ARCHIVE_MAX_UNCOMPRESSED_BYTES=524288000
PROJECT_ARCHIVE_MAX_COMPRESSION_RATIO=100

# GitLab
GITLAB_TOKEN=

# Nexus
NEXUS_PASSWORD=

# Argo CD
ARGOCD_TOKEN=

# Kubernetes
KUBERNETES_TOKEN=

# k6 / Performance : aucune variable PERFORMANCE_* n'est requise.
# La cible, Prometheus et Grafana sont configurés depuis l'interface.
