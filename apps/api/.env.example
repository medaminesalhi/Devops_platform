APP_ENV=development

SECRET_KEY=replace-with-a-long-random-secret

DATABASE_URL=postgresql://piximind_app:replace-password@127.0.0.1:5432/piximind_platform

AUTH_SESSION_HOURS=8
AUTH_REMEMBER_DAYS=7

CREDENTIAL_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

INTEGRATION_TIMEOUT_SECONDS=10
INTEGRATION_WORKER_SLEEP_SECONDS=60

# Temps maximal accordé à Ollama, LiteLLM, vLLM
# ou à une API compatible OpenAI.
AI_REQUEST_TIMEOUT_SECONDS=120

PROJECT_ARCHIVE_ROOT=var/project-archives
PROJECT_ARCHIVE_MAX_BYTES=104857600
PROJECT_ARCHIVE_MAX_ENTRIES=20000
PROJECT_ARCHIVE_MAX_UNCOMPRESSED_BYTES=524288000
PROJECT_ARCHIVE_MAX_COMPRESSION_RATIO=100

# GitLab
GITLAB_TOKEN=

# Nexus
NEXUS_PASSWORD=

# Argo CD
ARGOCD_TOKEN=

# Kubernetes
KUBERNETES_TOKEN=